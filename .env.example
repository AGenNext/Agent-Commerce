# Agent-Commerce environment template
# Copy to .env for local development. Use real secret management in production.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# API security
# Required in production. Use high-entropy values; never commit real secrets.
API_KEY=change-me-in-production
ADMIN_API_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Optional demo login for local testing only.
# Do not use demo credentials as a production identity provider.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000

# Rate limiting
# In-memory rate limiting is development-only. Use Redis or gateway limits for production replicas.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=

# SurrealDB
# Production must use a persistent external database URL, not mem://.
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=root
SURREALDB_PASSWORD=change-me
SURREALDB_NAMESPACE=ucp
SURREALDB_DATABASE=ecommerce
